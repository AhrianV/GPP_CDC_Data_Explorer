# Copy to .env and replace the secret before running the app.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Relative SQLite paths resolve from the project directory, not the shell's cwd.
DATABASE_URL=sqlite:///app.db
# Optional; omit to store workspace tables in DATABASE_URL instead.
WORKSPACE_DATABASE_URL=sqlite:///instance/workspace.db

GROQ_API_KEY=
# Use a shared Redis URL when running multiple app workers or hosts.
RATELIMIT_STORAGE_URI=memory://
